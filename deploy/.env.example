# Copy to deploy/.env on the VM, fill in real values, then: chmod 600 deploy/.env
# deploy/.env is gitignored and must never be committed.
#
# Generate any secret below with:  openssl rand -base64 36

# ── Where it lives ───────────────────────────────────────────────────
# The hostname Caddy will obtain a certificate for. Before DNS is ready you can use
# <vm-public-ip>.nip.io, which resolves to that IP and still gets a real certificate.
DOMAIN=smartmeetup.is-a.dev

# Promoted to the Admin role at startup, which is what grants access to /hangfire.
# Must match an account that has signed up.
ADMIN_EMAIL=you@example.com

# ── App secrets (required) ───────────────────────────────────────────
# 32+ characters. Changing this invalidates every issued token.
JWT_KEY=
POSTGRES_PASSWORD=

# ── LiveKit (required — calls do not work without these) ─────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Object storage for recordings (required) ─────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=meetup-recordings

# ── Transcription (optional) ─────────────────────────────────────────
# Without this, meetings are recorded but never transcribed — and because analysis, speaker
# attribution and search all read the transcript, none of those run either.
# assemblyai.com — 100 hours of free credit.
ASSEMBLYAI_API_KEY=

# ── AI analysis (optional) ───────────────────────────────────────────
# Leave a provider blank to hide it from the picker. Gemini is the default and is free:
# aistudio.google.com/apikey — the same key also powers semantic search embeddings.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ── Email (optional) ─────────────────────────────────────────────────
# Without a key, follow-up emails are drafted but sending refuses with a clear message.
# resend.com — 3,000/month free. The domain must be verified with Resend first.
RESEND_API_KEY=
EMAIL_FROM=noreply@smartmeetup.is-a.dev

# ── Logs ─────────────────────────────────────────────────────────────
# Seq is reachable at https://$DOMAIN/logs, so give it a real password.
# Generate the hash with:
#   docker run --rm datalust/seq config hash 'your-password'
SEQ_ADMIN_PASSWORD_HASH=
