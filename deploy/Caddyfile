# One hostname serves everything. Caddy obtains and renews the certificate automatically over the
# HTTP-01 challenge, which is why port 80 must stay open even though all traffic is redirected.
#
# DOMAIN comes from deploy/.env.

{$DOMAIN} {
	encode zstd gzip

	# ── API ───────────────────────────────────────────────────────────
	# Matched before the SPA catch-all below, because Caddy evaluates handle blocks in order.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /health/* {
		reverse_proxy api:8080
	}

	# SignalR needs the connection upgraded; reverse_proxy handles that automatically.
	handle /meetingHub* {
		reverse_proxy api:8080
	}

	# Hangfire's own dashboard auth is admin-role based, but it is not something to leave open to
	# casual discovery either — keep the path obscure-ish and rely on the app's filter.
	handle /hangfire* {
		reverse_proxy api:8080
	}

	# ── LiveKit signalling ────────────────────────────────────────────
	# Only the WebSocket goes through here. Media travels over UDP 7881/7882 published directly on
	# the host, because WebRTC media cannot pass through an HTTPS reverse proxy.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	# ── The Angular app ───────────────────────────────────────────────
	# Must be last: this matches anything the blocks above did not claim.
	handle {
		reverse_proxy web:80
	}

	# Long timeouts would otherwise cut off SignalR's long-lived connections.
	header {
		# Caddy adds HSTS automatically on HTTPS; these are the ones it does not.
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the header that advertises the server software.
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ── Recordings ────────────────────────────────────────────────────────
# Its own hostname, not a /storage path on the main site. Presigned URLs are AWS SigV4, which signs
# both the Host header and the URI path: stripping a /storage prefix on the way through would change
# the path MinIO recomputes the signature over, and every link would come back SignatureDoesNotMatch.
# Proxying a whole hostname leaves the request byte-identical, so the signature validates.
#
# Objects stay private — the signature in the query string is the only thing that authorises access.
# With DOMAIN set to <ip>.nip.io this resolves too: nip.io maps any *.<ip>.nip.io to that IP.
storage.{$DOMAIN} {
	encode zstd gzip

	# Recordings are large and uploads come from the egress worker inside the network, so don't let
	# Caddy cap the body size on the way through.
	request_body {
		max_size 0
	}

	reverse_proxy minio:9000

	log {
		output stdout
		format console
	}
}

# ── Logs (Seq) ────────────────────────────────────────────────────────
# Also its own hostname rather than a /logs path: Seq serves its UI with absolute asset paths, so
# behind a stripped prefix the page loads and every script and stylesheet 404s.
# Protected by Seq's own admin login.
logs.{$DOMAIN} {
	encode zstd gzip

	reverse_proxy seq:80

	log {
		output stdout
		format console
	}
}
